# From https://my.telegram.org -> "API development tools"
TG_API_ID=
TG_API_HASH=

# From @BotFather -> /newbot
TG_BOT_TOKEN=

# Optional: where the database and login files are kept (default: ./data)
# DATA_DIR=data

# Optional, for cloud hosts where you can't type the login code.
# Generate it with:  python -m kwalert --session-string
# TG_SESSION=
